<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Example usage: explicit widgets are optional because date/datetime are auto-overridden. -->
    <record id="view_partner_form_hijri_example" model="ir.ui.view">
        <field name="name">res.partner.form.hijri.example</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Hijri Date Example">
                    <field name="date" widget="hijri_date"/>
                    <field name="create_date" widget="hijri_datetime" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_hijri_example" model="ir.ui.view">
        <field name="name">res.partner.tree.hijri.example</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="create_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
